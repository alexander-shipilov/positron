{
  "private": false,
  "name": "@positron/css-numeric",
  "version": "0.0.1",
  "description": "TypeScript interfaces for CSS Typed OM numeric values and math expressions",
  "license": "MIT",
  "author": "Alexander Shipilov <alexander.shipilov@gmail.com>",
  "repository": "git@github.com:alexander-shipilov/positron.git",
  "keywords": [
    "css",
    "css-typed-om",
    "numeric",
    "positron",
    "typescript"
  ],
  "sideEffects": false,
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/dts/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/esm/index.js",
      "node": "./lib/cjs/index.js",
      "require": "./lib/cjs/index.js",
      "types": "./lib/dts/index.d.ts"
    }
  },
  "scripts": {
    "_phase:build": "heft run --only build -- --clean",
    "_phase:test": "heft run --only test -- --clean",
    "build": "heft build --clean",
    "test": "heft test --clean"
  },
  "dependencies": {
    "@positron/lang": "workspace:*"
  },
  "devDependencies": {
    "@jest/globals": "~30.5.2",
    "@microsoft/api-extractor": "~7.59.4",
    "@positron/heft-lib-rig": "workspace:*",
    "@rushstack/heft": "~1.3.3",
    "eslint": "^10.13.0",
    "expect-type": "^1.4.0",
    "jest": "~30.5.2",
    "ts-jest": "~29.4.15",
    "typescript": "^6.0.3"
  }
}
