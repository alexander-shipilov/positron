{
  "private": false,
  "name": "@positron/foobar-smp-enums",
  "version": "0.0.1",
  "license": "MIT",
  "author": "Alexander Shipilov <alexander.shipilov@gmail.com>",
  "repository": "git@github.com:alexander-shipilov/positron.git",
  "type": "module",
  "sideEffects": false,
  "files": [
    "./dist",
    "./lib"
  ],
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/esm/index.js",
      "node": "./lib/cjs/index.js",
      "require": "./lib/cjs/index.js",
      "types": "./dist/index.d.ts"
    },
    "./lib/*": {
      "import": "./lib/esm/*.js",
      "node": "./lib/cjs/*.js",
      "require": "./lib/cjs/*.js",
      "types": "./lib/dts/*.d.ts"
    }
  },
  "scripts": {
    "_phase:build": "heft run --only build -- --clean",
    "_phase:test": "heft run --only test -- --clean",
    "docs": "npm run build & api-documenter markdown -i dist -o docs/api",
    "build": "heft build --clean",
    "test": "heft test --clean"
  },
  "dependencies": {
  },
  "devDependencies": {
    "@jest/globals": "~30.4.0",
    "@microsoft/api-documenter": "~7.30.5",
    "@positron/heft-rig": "workspace:*",
    "@rushstack/heft": "~1.2.17",
    "@types/node": "~25.6.2",
    "eslint": "^10.3.0",
    "expect-type": "^1.3.0",
    "jest": "~30.4.0",
    "react": "~19.2.6",
    "ts-jest": "~29.4.9",
    "typescript": "^6.0.3",
    "ts-node": "~10.9.2"
  }
}
